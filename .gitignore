# env
.env
.env.local

# Generated AES key for the secrets the setup wizard stores. Committing it would
# publish the key that protects the Notion token and the Google client secret.
data/
apps/api/data/
*.key

# jvm / gradle
apps/api/build/
apps/api/.gradle/
apps/api/bin/
*.class
*.log

# node / next
node_modules/
apps/web/.next/
apps/web/out/
apps/web/next-env.d.ts
.pnpm-store/

# playwright
#
# The globs cover the suffixed copies too, and that is not tidiness: `KANSO_E2E_OUTPUT_DIR`
# and `KANSO_E2E_REPORT_DIR` exist so two runs in one checkout stop clearing each other's
# traces, and every value anybody gives them — `test-results-b`, `playwright-report-w` —
# landed outside these two rules. The first agent to use the pair committed a report.
/test-results*/
/playwright-report*/
/blob-report/
/playwright/.cache/

# editors
.idea/
.vscode/
*.iml
.DS_Store

# learner (local, per-repo)
.claude/learner.local.json

# agent scratch (worktrees, plan-execution ledger)
.claude/worktrees/
.superpowers/

# Design source material, kept on disk and out of the history. The handoff bundle and
# the mobile drawings are inputs to the work, not part of the product: 313 KB that every
# clone of an AGPL repository would carry forever, and they entered once by a `git add -A`
# during a merge resolution rather than by anyone's decision.
Kanso - Mobile.dc.html
*.dc.html
Kanso Design System*.zip

# Two build outputs, one directory name, and neither is ever committed.
#
# The published site: `node site/build.mjs` rebuilds it from site/ in seconds, and the
# workflow that deploys it does exactly that, so a committed copy could only ever be a
# stale second answer to what the page says.
#
# And the release's artefacts: `release.yml` downloads the jar and the Next bundle into
# `dist/app.jar` and `dist/web`, which is where `docker/Dockerfile`'s `api-prebuilt` and
# `web-prebuilt` stages read them from. The rule below already covered them — this comment
# is the change, because a rule whose stated reason is the site is a rule someone narrows
# to `/dist/*.html` one day and then wonders why a release is committing a 90 MB jar.
#
# They share the directory and never the moment: no workflow builds both, and locally
# `node site/build.mjs` after a `docker build` leaves you a dist/ holding a site and a jar.
# Delete it between the two rather than trusting either to clean up after the other.
dist/

# The raw captures `pnpm shots` writes: 1440×900 at 2×, PNG because Playwright encodes
# nothing else, and about 1.1 MB for the five. Those stay out for the reason above.
#
# `v1/` is the exception, and it is not a relaxation of that rule — it is the same rule
# measured again. `pnpm shots:pack` re-encodes the five as WebP at 1920 wide: 233 KB for
# the whole set, less than the 313 KB of design material the paragraph above refuses, and
# the site serves them itself instead of pointing at a host that can go dark under a live
# page. A clip is still 5-30 MB per revision and still does not belong here.
#
# `site/media/*` and not `site/media/`: git does not descend into an ignored directory, so
# a trailing slash would make the negation below unreachable.
site/media/*
!site/media/v1/
