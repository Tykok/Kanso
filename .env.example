# Copy to .env and fill in. `docker compose up` reads this file.

# ---- Postgres ----
POSTGRES_DB=kanso
POSTGRES_USER=kanso
POSTGRES_PASSWORD=kanso
POSTGRES_PORT=5432

# ---- API ----
API_PORT=8080
# Where the browser reaches the web app. Used for OAuth redirects and CORS.
KANSO_WEB_ORIGIN=http://localhost:3000

# Auth mode: "oidc" (production) or "dev" (no login, X-Kanso-User header).
# "dev" is for local hacking and tests only — never expose it.
# Leave it as "oidc": on first launch Kanso shows a setup wizard where you create
# the owner account with an email and a password.
KANSO_AUTH_MODE=oidc

# Encrypts the Notion token and Google client secret stored by the setup wizard.
# Base64 of 32 random bytes:  openssl rand -base64 32
# Leave empty and one is generated into the kanso-data volume on first boot — back
# that volume up, or the stored secrets become unreadable and must be re-entered.
KANSO_SECRET_KEY=

# ---- OIDC providers (optional) ----
# You can leave these empty and configure Google from the setup wizard instead.
# Anything set here WINS over the wizard and is shown read-only in the UI, so that
# operator config and in-app config cannot silently disagree.
# Google: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers
# Authorization callback URL: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Notion mirror (optional) ----
# Also configurable from the setup wizard; same precedence rule as above.
# Leave NOTION_TOKEN empty to run fully offline: sync jobs are recorded and
# completed by a no-op client, so nothing in the app blocks or fails.
# Internal integration token: https://www.notion.so/profile/integrations
NOTION_TOKEN=

# The public integration consent is asked *through* — not a token, and not the same
# question as NOTION_TOKEN above. Create it once at
# https://www.notion.so/profile/integrations with
# http://localhost:8080/api/setup/notion/callback as its redirect URI, put the two
# values here, and no instance ever asks for them again: connecting Notion is one
# button on every fresh database. Nothing is connected until somebody consents.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Page under which Kanso creates its four databases at bootstrap.
# Share that page with the integration first.
NOTION_PARENT_PAGE_ID=
NOTION_API_VERSION=2025-09-03

# ---- Web ----
WEB_PORT=3000
