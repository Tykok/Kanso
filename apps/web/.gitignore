# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# The exception, and it holds a secret only in the sense that :8080 is one. Development is
# the only two-origin topology left — a published image serves both halves on one — so this
# is where `pnpm dev` is told where the API is, and it has to be in the clone for the
# command to work at all. Next loads it for `dev` and never for `build`.
!.env.development

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
