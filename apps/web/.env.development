# Development is the one topology with two origins: `next dev` on :3000, the API on :8080.
#
# `lib/api/core.ts` defaults `API_URL` to the empty string so a published image resolves
# `/api/...` against whatever host it was reached on — there is one origin there, and a
# proxy in front of both halves. Nothing proxies :3000, so `pnpm dev` needs the address
# said out loud, and this is the file that says it.
#
# Next loads `.env.development` for `next dev` and never for `next build`, so no value
# here can be inlined into a distributed bundle. That is the whole reason it is this file
# and not `.env`.
NEXT_PUBLIC_API_URL=http://localhost:8080
